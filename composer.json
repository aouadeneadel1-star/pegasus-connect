{
    "name": "pegasus-insure/pegasus-connect",
    "description": "Plateforme employés Pegasus Insure : pointage, rondes, RH et portail client.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.0",
        "endroid/qr-code": "^6.0",
        "phpmailer/phpmailer": "^6.9",
        "pragmarx/google2fa": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@php bin/migrate.php --env=testing --fresh",
            "@php bin/seed.php --env=testing",
            "phpunit"
        ],
        "test:unit": "phpunit --testsuite Unit",
        "migrate": "@php bin/migrate.php",
        "seed": "@php bin/seed.php",
        "verifier": "@php bin/verifier-environnement.php"
    }
}
