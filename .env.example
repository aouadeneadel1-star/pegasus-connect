# Copier en .env (jamais versionné) et compléter.

APP_ENV=production
APP_DEBUG=0
APP_URL=https://app.pegasus-insure.fr
APP_TIMEZONE=Europe/Paris

# Clé maître, 32 octets en base64 : php bin/generer-cle.php
# Elle dérive les clés des QR, des badges, du NIR et des URL signées.
# La changer rend illisibles les données déjà chiffrées.
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pegasus-insure.fr
MAIL_FROM_NAME="Pegasus Insure"

# Chemin absolu du dossier storage, utilisé pour générer public/.user.ini.
# Laisser vide pour utiliser <racine du projet>/storage.
STORAGE_PATH=

# Binaire mysqldump utilisé par la sauvegarde quotidienne, si absent du PATH du cron.
MYSQLDUMP_PATH=mysqldump
