# Configuration du serveur o2switch pour connect.pegasus-groupe.com.
# Versionné uniquement dans le dépôt privé. Ne jamais le déposer dans public/.

APP_ENV=production
APP_DEBUG=0
APP_URL=https://connect.pegasus-groupe.com
APP_TIMEZONE=Europe/Paris

# Clé maître. Ne plus jamais la modifier une fois l'application en service :
# elle chiffre les n° de sécurité sociale et les sauvegardes, et signe les QR imprimés.
APP_KEY=Zomo11FqwytJfmT2Srxvt5oF03n6UoaadyDevcDnV8U=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=koja2237_connect
DB_USER=koja2237_connect
DB_PASSWORD='G3lPt#TvZ1;pDOUg'

# Sans MAIL_HOST, les e-mails partent par la messagerie locale d'o2switch.
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@connect.pegasus-groupe.com
