# Base dédiée aux tests d'intégration : recréée à chaque exécution de composer test.
# Le nom de la base doit se terminer par « _test ».
# Ne jamais pointer vers la base de développement ou de production.

APP_ENV=testing
APP_DEBUG=1
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Paris
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pegasus_test
DB_USER=pegasus
DB_PASSWORD=

MAIL_HOST=
MAIL_PORT=1025
MAIL_ENCRYPTION=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pegasus.test
MAIL_FROM_NAME="Pegasus Insure"

STORAGE_PATH=
